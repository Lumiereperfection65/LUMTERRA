# Application mode: demo (localStorage) or production (Supabase)
VITE_APP_MODE=demo

# Supabase Dashboard > Project Settings > API
# Use the Project URL and the anon/public or publishable key only.
# Never use service_role or sb_secret_* in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional server-side image analysis. Never expose this key in VITE_* variables.
GEMINI_API_KEY=
