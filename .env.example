# Copiez ce fichier en .env.
# Supabase Dashboard > Project Settings > API : Project URL et clé anon/public.
# Une clé publishable (sb_publishable_...) convient aussi si le projet l'utilise.
# Ne renseignez jamais une clé service_role/secret ici.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
